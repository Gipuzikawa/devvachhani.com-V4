# Public identifiers; configure all three runtimes for the same dataset.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=development
SANITY_PROJECT_ID=
SANITY_DATASET=development
# Canonical frontend + Studio origin, never inferred from request Host.
SITE_ORIGIN=https://localhost:3000
# Server-only: dedicated Viewer token, never VITE_ or SANITY_STUDIO_ prefixed.
SANITY_API_READ_TOKEN=
# Server-only: generate with crypto.randomBytes(32).toString('hex').
PREVIEW_SESSION_SECRET=
# Import token belongs only to local import tooling, never deployment env.
